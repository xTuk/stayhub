# ------------------------------------------------------------------
# StayHub — environment variables
# Copy this file to `.env` for local development and fill in real
# values. Never commit `.env` (it is already gitignored).
# ------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Works with any Postgres provider; the
# production deployment for this project uses hosted Neon Postgres.
# Neon example:
#   postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/stayhub?sslmode=require
# Local Postgres (docker) example:
#   postgresql://postgres:postgres@localhost:5432/stayhub?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stayhub?schema=public"

# --- Auth ---------------------------------------------------------------
# Secret used to sign JWTs issued on login/signup. Use a long random
# string in production, e.g. `openssl rand -base64 48`.
JWT_SECRET="replace-with-a-long-random-string"

# --- AWS S3 (property photo galleries) --------------------------------------
# Used to generate presigned upload URLs so images upload directly from the
# browser to S3. If any of these are missing, photo upload is disabled and
# the app shows a clear "S3 not configured" message instead of crashing.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# --- Stripe (test mode checkout simulation) ---------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. If unset,
# booking checkout falls back to an instant simulated confirmation so the
# app still works end-to-end without real Stripe credentials.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---------------------------------------------------------------
# Public base URL of the app, used to build Stripe success/cancel redirect
# URLs. Set to your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
